FROM node:22-alpine

WORKDIR /app

# As dependências ficam no volume nomeado `frontend_node_modules` (ver
# docker-compose.yml). Instalar aqui dentro duplicaria ~418 MB na imagem;
# o entrypoint instala apenas quando o volume estiver vazio.
COPY package*.json ./

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
